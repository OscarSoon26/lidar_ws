<?xml version="1.0"?>
<robot name="final_robot">

  <!-- ======================================================= -->
  <!-- MATERIALS (Consolidated)                                -->
  <!-- ======================================================= -->
  <material name="white"><color rgba="0.9 0.9 0.9 1.0"/></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
  <material name="red"><color rgba="0.8 0.1 0.1 1.0"/></material>
  <material name="blue"><color rgba="0.2 0.2 0.8 1.0"/></material>
  <material name="green"><color rgba="0.0 1.0 0.0 1.0"/></material>

  <!-- ======================================================= -->
  <!-- PART 1: MOBILE VEHICLE BASE                             -->
  <!-- ======================================================= -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.065" rpy="0 0 0"/>
  </joint>

  <link name="base_link"/>

  <!-- CHASSIS -->
  <link name="chassis">
    <visual>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
      <geometry>
        <mesh filename="file:///home/oscar/my_robot_ws/src/robot_description/meshes/base_robot.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.38 0.38 0.08"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.06283" ixy="0.0" ixz="0.0" iyy="0.06283" iyz="0.0" izz="0.12033"/>
    </inertial>
  </link>

  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin xyz="-0.09925 0 0.10675" rpy="0 0 0"/>
  </joint>

  <!-- LEFT HUB WHEEL -->
  <link name="left_wheel">
    <visual>
      <origin xyz="0 0.0675 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/oscar/my_robot_ws/src/robot_description/meshes/hub_wheel.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <geometry>
        <cylinder radius="0.065" length="0.038"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.00118" ixy="0.0" ixz="0.0" iyy="0.00118" iyz="0.0" izz="0.00211"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0.035 -0.09 0.04" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="10.0" velocity="10.0"/>
  </joint>

  <!-- RIGHT HUB WHEEL -->
  <link name="right_wheel">
    <visual>
      <origin xyz="0 0.0675 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/oscar/my_robot_ws/src/robot_description/meshes/hub_wheel.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <geometry>
        <cylinder radius="0.065" length="0.038"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.00118" ixy="0.0" ixz="0.0" iyy="0.00118" iyz="0.0" izz="0.00211"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="-0.225 -0.09 0.04" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="10.0" velocity="10.0"/>
  </joint>

  <!-- LEFT CASTER -->
  <link name="left_caster">
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.025"/></geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.00006"/>
    </inertial>
  </link>

  <joint name="left_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_caster"/>
    <origin xyz="-0.1985 0.14 -0.04" rpy="0 0 0"/>
  </joint>

  <gazebo reference="left_caster">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <!-- RIGHT CASTER -->
  <link name="right_caster">
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.025"/></geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.00006"/>
    </inertial>
  </link>

  <joint name="right_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_caster"/>
    <origin xyz="-0.1985 -0.14 -0.04" rpy="0 0 0"/>
  </joint>

  <gazebo reference="right_caster">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <!-- SENSORS: LIDAR -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.04"/></geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.12"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.000043" ixy="0.0" ixz="0.0" iyy="0.000043" iyz="0.0" izz="0.000054"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="chassis"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.125" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <material>Gazebo/Red</material>
    <sensor type="ray" name="lidar_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize> 
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>180</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="gazebo_ros_lidar" filename="libgazebo_ros_ray_sensor.so">
        <ros><remapping>~/out:=scan</remapping></ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>laser</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- SENSORS: IMU -->
  <link name="imu_link">
    <visual>
      <geometry><box size="0.02 0.02 0.01"/></geometry>
      <material name="black"/>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.000002" ixy="0.0" ixz="0.0" iyy="0.000002" iyz="0.0" izz="0.000003"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="chassis"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ======================================================= -->
  <!-- THE BRIDGE: CONNECTING CHASSIS TO ROBOT ARM             -->
  <!-- ======================================================= -->
  <!-- CHANGE XYZ HERE TO MOVE THE ARM POSITION ON THE CAR:    -->
  <joint name="chassis_to_arm_joint" type="fixed">
    <parent link="chassis"/>
    <child link="arm_base_link"/>
    <!-- Position: X=forward/back, Y=left/right, Z=height on chassis -->
    <origin xyz="0 -0.1 0.22" rpy="0 0 -2.6"/> 
  </joint>

  <!-- ======================================================= -->
  <!-- PART 2: ROBOT ARM & GRIPPER                             -->
  <!-- ======================================================= -->
  <link name="arm_base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 2.65"/>
      <geometry>
        <mesh filename="package://robot_arm/mesh/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 2.65"/>
      <geometry>
        <mesh filename="package://robot_arm/mesh/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="link_1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm/mesh/link_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm/mesh/link_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_joint" type="revolute">
    <parent link="arm_base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.0615" rpy="0 0 1.025"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.39" upper="1.39" effort="10.0" velocity="1.0"/>
  </joint>

  <link name="link_2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm/mesh/link_2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm/mesh/link_2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint_1" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0.0114 0.075" rpy="0 0 -1.5708"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.60" upper="0.38" effort="10.0" velocity="1.0"/>
  </joint>

  <link name="link_3">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm/mesh/link_3.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm/mesh/link_3.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint_2" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0.03 0 0.24" rpy="0 1.5708 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.23" upper="1.60" effort="10.0" velocity="1.0"/>
  </joint>

  <link name="link_4">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm/mesh/link_4.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm/mesh/link_4.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint_3" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="0 0.24 -0.015" rpy="-1.5708 3.14159 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.54" upper="1.52" effort="10.0" velocity="1.0"/>
  </joint>

  <link name="link_5">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm/mesh/link_5.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="green"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_arm/mesh/link_5.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint_4" type="revolute">
    <parent link="link_4"/>
    <child link="link_5"/>
    <origin xyz="0 0 0.13" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.55" upper="3.14" effort="10.0" velocity="1.0"/>
  </joint>

  <!-- GRIPPER -->
  <link name="gripper_base">
    <visual>
      <origin xyz="0 0 0.072405" rpy="1.5708 0 -1.5708"/>
      <geometry>
        <mesh filename="package://robot_arm/mesh/gripper_base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.072405" rpy="1.5708 0 -1.5708"/>
      <geometry>
        <mesh filename="package://robot_arm/mesh/gripper_base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="gripper_mount" type="fixed">
    <parent link="link_5"/>
    <child link="gripper_base"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- LEFT FINGER -->
  <link name="left_finger">
    <visual>
      <origin xyz="0 0 0.0725" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="package://robot_arm/mesh/finger.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.0725" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="package://robot_arm/mesh/finger.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_finger_joint" type="prismatic">
    <parent link="gripper_base"/>
    <child link="left_finger"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.04" effort="20.0" velocity="0.05"/>
  </joint>

  <!-- RIGHT FINGER (MIMIC) -->
  <link name="right_finger">
    <visual>
      <origin xyz="0 0 0.0725" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="package://robot_arm/mesh/finger.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.0725" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="package://robot_arm/mesh/finger.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_finger_joint" type="prismatic">
    <parent link="gripper_base"/>
    <child link="right_finger"/>
    <origin xyz="0 0 0" rpy="0 0 3.14159"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.04" effort="20.0" velocity="0.05"/>
    <mimic joint="left_finger_joint" multiplier="1.0" offset="0.0"/>
  </joint>

  <!-- DEPTH CAMERA -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 1.57 0"/>
      <geometry><box size="0.022 0.060 0.015"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.025 0.090 0.025"/></geometry>
    </collision>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="gripper_base"/>
    <child link="camera_link"/>
    <origin xyz="0.078 0.006 0.070" rpy="0 -1.92 0"/>
  </joint>

  
  


  <!-- ======================================================= -->
  <!-- ROS 2 CONTROL HARDWARE INTERFACE (FOR THE ARM)          -->
  <!-- ======================================================= -->
  <ros2_control name="real_arm" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
    </hardware>
    <joint name="base_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_1">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_2">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_3">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_4">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_finger_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_finger_joint">
      <state_interface name="position"/>
      <param name="mimic">left_finger_joint</param>
      <param name="multiplier">1.0</param>
    </joint>
  </ros2_control>

  <!-- ======================================================= -->
  <!-- GAZEBO PLUGINS (FOR THE VEHICLE)                        -->
  <!-- ======================================================= -->
  <gazebo>
    <plugin name="front_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.26</wheel_separation>
      <wheel_diameter>0.13</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>2.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

</robot>