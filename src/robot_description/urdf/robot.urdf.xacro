<?xml version="1.0"?>
<robot name="front_diff_robot">

  <!-- ======================================================= -->
  <!-- MATERIALS                                               -->
  <!-- ======================================================= -->
  <material name="white"><color rgba="0.9 0.9 0.9 1.0"/></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
  <material name="red"><color rgba="0.8 0.1 0.1 1.0"/></material>

  <!-- ======================================================= -->
  <!-- BASE FOOTPRINT & BASE LINK                              -->
  <!-- ======================================================= -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <!-- Elevates base_link to the center of the 13cm hub wheels -->
    <origin xyz="0 0 0.065" rpy="0 0 0"/>
  </joint>

  <link name="base_link"/>

  <!-- ======================================================= -->
  <!-- CHASSIS (Visual: robot_base + custom casters from CAD)  -->
  <!-- ======================================================= -->
  <link name="chassis">
    <visual>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
      <geometry>
        <!-- Loads your merged 3D CAD model (Chassis + Casters) -->
        <mesh filename="file:///home/oscar/my_robot_ws/src/robot_description/meshes/base_robot.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="white"/>
    </visual>
    <!-- Simple collision box for fast physics -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.38 0.38 0.08"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.06283" ixy="0.0" ixz="0.0" iyy="0.06283" iyz="0.0" izz="0.12033"/>
    </inertial>
  </link>

  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin xyz="-0.09925 0 0.10675" rpy="0 0 0"/>
  </joint>

  <!-- ======================================================= -->
  <!-- DRIVE WHEELS (Visual: Real Hub Wheels)                   -->
  <!-- ======================================================= -->
  <!-- LEFT HUB WHEEL -->
  <link name="left_wheel">
    <visual>
      <origin xyz="0 0.0675 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/oscar/my_robot_ws/src/robot_description/meshes/hub_wheel.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <geometry>
        <cylinder radius="0.065" length="0.038"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.00118" ixy="0.0" ixz="0.0" iyy="0.00118" iyz="0.0" izz="0.00211"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0.035 -0.09 0.04" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="10.0" velocity="10.0"/>
  </joint>

  <!-- RIGHT HUB WHEEL -->
  <link name="right_wheel">
    <visual>
      <origin xyz="0 0.0675 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file:///home/oscar/my_robot_ws/src/robot_description/meshes/hub_wheel.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.570796 0 0"/>
      <geometry>
        <cylinder radius="0.065" length="0.038"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.00118" ixy="0.0" ixz="0.0" iyy="0.00118" iyz="0.0" izz="0.00211"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="-0.225 -0.09 0.04" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="10.0" velocity="10.0"/>
  </joint>

  <!-- ======================================================= -->
  <!-- INVISIBLE ZERO-FRICTION SLIDING CONTACTS (Physics Only) -->
  <!-- ======================================================= -->
  <!-- LEFT CASTER -->
  <link name="left_caster">
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.025"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.00006"/>
    </inertial>
  </link>

  <joint name="left_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_caster"/>
    <origin xyz="-0.1985 0.14 -0.04" rpy="0 0 0"/>
  </joint>

  <gazebo reference="left_caster">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <!-- RIGHT CASTER -->
  <link name="right_caster">
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.025"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.00006"/>
    </inertial>
  </link>

  <joint name="right_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_caster"/>
    <origin xyz="-0.1985 -0.14 -0.04" rpy="0 0 0"/>
  </joint>

  <gazebo reference="right_caster">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <!-- ======================================================= -->
  <!-- SENSORS: LIDAR                                          -->
  <!-- ======================================================= -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.04"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.12"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.000043" ixy="0.0" ixz="0.0" iyy="0.000043" iyz="0.0" izz="0.000054"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="chassis"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.125" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo LiDAR Plugin -->
  <gazebo reference="lidar_link">
    <material>Gazebo/Red</material>
    <sensor type="ray" name="lidar_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize> 
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>180</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="gazebo_ros_lidar" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>laser</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ======================================================= -->
  <!-- SENSORS: IMU                                            -->
  <!-- ======================================================= -->
  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.02 0.02 0.01"/>
      </geometry>
      <material name="black"/>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.000002" ixy="0.0" ixz="0.0" iyy="0.000002" iyz="0.0" izz="0.000003"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="chassis"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ======================================================= -->
  <!-- GAZEBO DIFFERENTIAL DRIVE PLUGIN                        -->
  <!-- ======================================================= -->
  <gazebo>
    <plugin name="front_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.26</wheel_separation>
      <wheel_diameter>0.13</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>2.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

</robot>