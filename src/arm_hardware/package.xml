<?xml version="1.0"?>
<package format="3">
  <name>arm_hardware</name>
  <version>0.1.0</version>
  <description>ros2_control hardware interface for the 5-DOF stepper arm and gripper (ESP32-S3 over USB serial).</description>
  <maintainer email="alsonwong280@gmail.com">alson_wong</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
