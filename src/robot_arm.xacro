<?xml version="1.0"?>
<robot name="my_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

     <material name="red">
        <color rgba="1 0 0 1"/>
    </material>

    <material name="white">
        <color rgba="1 1 1 1"/>
    </material>

    <material name="blue">
        <color rgba="0 0 1 1"/>
    </material>

    <material name="black">
      <color rgba="0 0 0 1"/>
    </material>

    <material name="green">
      <color rgba="0 1 0 1"/>
    </material>

    <link name="world"/>

    <link name="base_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
              <mesh filename="package://robot_arm/mesh/base_link.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="black"/>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
              <mesh filename="package://robot_arm/mesh/base_link.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
        
    </link>

    <link name="link_1">
        <visual>
            <origin xyz="0.0 0 0.0" rpy="0 0 0"/>
            <geometry>
              <mesh filename="package://robot_arm/mesh/link_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="white"/>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
              <mesh filename="package://robot_arm/mesh/link_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
        
    </link>

    <link name="link_2">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>        
              <mesh filename="package://robot_arm/mesh/link_2.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 3.14"/>
            <geometry>

                 <mesh filename="package://robot_arm/mesh/link_2.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
        
    </link>

      <link name="link_3">
        <visual>
            <origin xyz="0 0 0.0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://robot_arm/mesh/link_3.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>

                <mesh filename="package://robot_arm/mesh/link_3.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
        
    </link>

    <link name="link_4">
        <visual>
            <origin xyz="0 -0.0 0.0" rpy="1.57 0 0"/>
            <geometry>
               
                <mesh filename="package://robot_arm/mesh/link_4.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="red"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="1.57 0 0"/>
            <geometry>
              <mesh filename="package://robot_arm/mesh/link_4.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
    
    </link>

    <!-- NEW: 5th link for the upgraded axis -->
    <link name="link_5">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
              <mesh filename="package://robot_arm/mesh/link_5.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="green"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
              <mesh filename="package://robot_arm/mesh/link_5.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
    </link>


  <joint name="base_joint" type="revolute">
        <parent link="base_link"/>
        <child link="link_1"/>
        <origin xyz="0 0 0.0615" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="0" upper="3.14" effort="10" velocity="1"/>
  </joint>

  <joint name="joint_1" type="revolute">
        <parent link="link_1"/>
        <child link="link_2"/>
        <origin xyz="0 0.0114 0.075" rpy="0 0 1.5708"/>
        <axis xyz="1 0 0"/>
        <limit lower="-1.6" upper="0.15" effort="10" velocity="1"/>
  </joint>

  <joint name="joint_2" type="revolute">
        <parent link="link_2"/>
        <child link="link_3"/>
        <origin xyz="-0.03 0 0.24" rpy="0 1.5708 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.25" upper="1.6" effort="10" velocity="1"/>
  </joint>

  <joint name="joint_3" type="revolute">
        <parent link="link_3"/>
        <child link="link_4"/>
        <origin xyz="0 0.24 0.015" rpy="-1.5708 0.0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-2.03" upper="2.03" effort="10" velocity="1"/>
  </joint>

  <!-- NEW: 5th DOF, wrist-style rotation. Adjust origin/axis/limits to match real hardware -->
  <joint name="joint_4" type="revolute">
        <parent link="link_4"/>
        <child link="link_5"/>
        <origin xyz="0 0 0.13" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="0" upper="3.14" effort="10" velocity="1"/>
  </joint>

</robot>