<launch>
  <let name="urdf_path" value="$(find-pkg-share arm_description)/urdf/final_robot.urdf" />

  <node pkg="robot_state_publisher" exec="robot_state_publisher">
    <param name="robot_description" value="$(command 'cat $(var urdf_path)')" type="str"/>
  </node>

  <node pkg="joint_state_publisher_gui" exec="joint_state_publisher_gui" />

  <node pkg="rviz2" exec="rviz2" args="-d $(find-pkg-share arm_description)/rviz/display.rviz" />
</launch>
