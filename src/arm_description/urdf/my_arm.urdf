<?xml version="1.0"?>
<robot name="my_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!--
      Homing reference (real arm resting on all 5 switches), in model radians:
        base_joint = 0.00   joint_1 = 0.40   joint_2 = -1.25   joint_3 = 1.54   joint_4 = -1.57
      Joint limits keep a 0.02 rad (~1 deg) margin inside each switch so MoveIt never
      plans onto a switch. The far-side limits are kept as you set them.
    -->

    <material name="red">
        <color rgba="1 0 0 1"/>
    </material>

    <material name="white">
        <color rgba="1 1 1 1"/>
    </material>

    <material name="blue">
        <color rgba="0 0 1 1"/>
    </material>

    <material name="black">
      <color rgba="0 0 0 1"/>
    </material>

    <material name="green">
      <color rgba="0 1 0 1"/>
    </material>

    <link name="world"/>

    <joint name="world_to_base" type="fixed">
        <parent link="world"/>
        <child link="base_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="base_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 2.65"/>
            <geometry>
              <mesh filename="package://robot_arm/mesh/base_link.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 2.65"/>
            <geometry>
              <mesh filename="package://robot_arm/mesh/base_link.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
    </link>

    <link name="link_1">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
              <mesh filename="package://robot_arm/mesh/link_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
              <mesh filename="package://robot_arm/mesh/link_1.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
    </link>

    <link name="link_2">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
              <mesh filename="package://robot_arm/mesh/link_2.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
              <mesh filename="package://robot_arm/mesh/link_2.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
    </link>

    <link name="link_3">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://robot_arm/mesh/link_3.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://robot_arm/mesh/link_3.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
    </link>

    <link name="link_4">
        <visual>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <geometry>
                <mesh filename="package://robot_arm/mesh/link_4.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="red"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="1.5708 0 0"/>
            <geometry>
              <mesh filename="package://robot_arm/mesh/link_4.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
    </link>

    <link name="link_5">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
              <mesh filename="package://robot_arm/mesh/link_5.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="green"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
              <mesh filename="package://robot_arm/mesh/link_5.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
    </link>

    <!-- ===================== GRIPPER (rack-and-pinion) ===================== -->
    <link name="gripper_base">
        <visual>
            <origin xyz="0 0 0.072405" rpy="1.5708 0 -1.5708"/>
            <geometry>
              <mesh filename="package://robot_arm/mesh/gripper_base.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <!-- FIXED: was xyz="0 0 072405" (72 km away) and yaw +1.57 instead of -1.57 -->
            <origin xyz="0 0 0.072405" rpy="1.5708 0 -1.5708"/>
            <geometry>
              <mesh filename="package://robot_arm/mesh/gripper_base.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
    </link>

    <joint name="gripper_mount" type="fixed">
        <parent link="link_5"/>
        <child link="gripper_base"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="left_finger">
        <visual>
            <origin xyz="0 0 0.0725" rpy="1.5708 0 1.5708"/>
            <geometry>
              <mesh filename="package://robot_arm/mesh/finger.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <!-- FIXED: was xyz="0 0 0725" (725 m away) -->
            <origin xyz="0 0 0.0725" rpy="1.5708 0 1.5708"/>
            <geometry>
              <mesh filename="package://robot_arm/mesh/finger.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
    </link>

    <!-- TODO: confirm the finger travel (0 to 0.04 m each side) against the real rack -->
    <joint name="left_finger_joint" type="prismatic">
        <parent link="gripper_base"/>
        <child link="left_finger"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="0.0" upper="0.04" effort="20" velocity="0.05"/>
    </joint>

    <link name="right_finger">
        <visual>
            <origin xyz="0 0 0.0725" rpy="1.5708 0 1.5708"/>
            <geometry>
              <mesh filename="package://robot_arm/mesh/finger.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <!-- FIXED: was xyz="0 0 0725" (725 m away) -->
            <origin xyz="0 0 0.0725" rpy="1.5708 0 1.5708"/>
            <geometry>
              <mesh filename="package://robot_arm/mesh/finger.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
    </link>

    <joint name="right_finger_joint" type="prismatic">
        <parent link="gripper_base"/>
        <child link="right_finger"/>
        <origin xyz="0 0 0" rpy="0 0 3.14159"/>
        <axis xyz="0 1 0"/>
        <limit lower="0.0" upper="0.04" effort="20" velocity="0.05"/>
        <mimic joint="left_finger_joint" multiplier="1.0" offset="0.0"/>
    </joint>
    <!-- =================== END GRIPPER =================== -->

    <!-- ===================== DEPTH CAMERA (on the gripper) =====================
      The camera mount is part of gripper_base.stl, so it needs nothing here.
      camera_link follows the ROS camera convention: x = the direction the camera looks,
      y = left, z = up. The camera driver adds its own optical frames below camera_link,
      so they are NOT defined here (defining them too would conflict with the driver).

      MEASURE AND SET (from your CAD, in the gripper_base frame):
        gripper_base frame = link_5 frame: z points out along the gripper toward the
        fingertips, the fingers slide along y, x is the remaining side.
        - xyz: where the camera's mounting point / front face centre is (metres)
        - rpy "0 -1.5708 0" makes the camera look along +z (toward the fingertips).
          If it is tilted down toward the fingers by an angle a, use "0 -(1.5708 - a) 0"
          or adjust after checking in RViz.
      If the driver's base frame is not called camera_link, rename the link to match it.
    -->
    <link name="camera_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 1.57 0"/>
            <geometry>
                <box size="0.022 0.060 0.015"/>   <!-- depth (along view) x width x height, metres -->
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.025 0.090 0.025"/>
            </geometry>
        </collision>
    </link>

    <joint name="camera_joint" type="fixed">
        <parent link="gripper_base"/>
        <child link="camera_link"/>
        <origin xyz="0.078 0.006 0.070" rpy="0 -1.92 0"/>   <!-- PLACEHOLDER: replace with measured values -->
    </joint>
    <!-- =================== END CAMERA =================== -->


    <!-- switch at 0.00 (lower end) -->
    <joint name="base_joint" type="revolute">
        <parent link="base_link"/>
        <child link="link_1"/>
        <origin xyz="0 0 0.0615" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="0.02" upper="2.65" effort="10" velocity="1"/>
    </joint>

    <!-- switch at 0.40 (upper end) -->
    <joint name="joint_1" type="revolute">
        <parent link="link_1"/>
        <child link="link_2"/>
        <origin xyz="0 0.0114 0.075" rpy="0 0 -1.5708"/>
        <axis xyz="1 0 0"/>
        <limit lower="-1.60" upper="0.38" effort="10" velocity="1"/>
    </joint>

    <!-- switch at -1.25 (lower end) -->
    <joint name="joint_2" type="revolute">
        <parent link="link_2"/>
        <child link="link_3"/>
        <origin xyz="0.03 0 0.24" rpy="0 1.5708 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.23" upper="1.60" effort="10" velocity="1"/>
    </joint>

    <!-- switch at 1.54 (upper end) -->
    <joint name="joint_3" type="revolute">
        <parent link="link_3"/>
        <child link="link_4"/>
        <origin xyz="0 0.24 -0.015" rpy="-1.5708 3.14159 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.54" upper="1.52" effort="10" velocity="1"/>
    </joint>

    <!-- switch at -1.57 (lower end) -->
    <joint name="joint_4" type="revolute">
        <parent link="link_4"/>
        <child link="link_5"/>
        <origin xyz="0 0 0.13" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.55" upper="3.14" effort="10" velocity="1"/>
    </joint>

    <ros2_control name="real_arm" type="system">
        <hardware>
            <plugin>arm_hardware/ArmHardwareInterface</plugin>
            <param name="serial_port">auto</param>
            <param name="homing_timeout">180</param>
        </hardware>
        <joint name="base_joint">
            <command_interface name="position"/>
            <state_interface name="position"/>
        </joint>
        <joint name="joint_1">
            <command_interface name="position"/>
            <state_interface name="position"/>
        </joint>
        <joint name="joint_2">
            <command_interface name="position"/>
            <state_interface name="position"/>
        </joint>
        <joint name="joint_3">
            <command_interface name="position"/>
            <state_interface name="position"/>
        </joint>
        <joint name="joint_4">
            <command_interface name="position"/>
            <state_interface name="position"/>
        </joint>
        <joint name="left_finger_joint">
            <command_interface name="position"/>
            <state_interface name="position"/>
        </joint>
        <joint name="right_finger_joint">
            <state_interface name="position"/>
            <param name="mimic">left_finger_joint</param>
            <param name="multiplier">1.0</param>
        </joint>
    </ros2_control>

</robot>